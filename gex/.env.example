# Copy this file to gex/.env and fill in your values.
# gex/.env is gitignored — your token stays local.

# Tradier API token (Settings -> API Access on tradier.com).
# Leave unset to use CBOE's free delayed data instead.
TRADIER_TOKEN=xcahPKQUsiCkN0hjhUMP48ILWIKi

# Uncomment if your token is a free developer-sandbox token:
# TRADIER_SANDBOX=1

# How many nearest expirations to pull from Tradier (default 12):
# TRADIER_MAX_EXPIRIES=20

# Server port (default 8787):
# PORT=8787
