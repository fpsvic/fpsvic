# Copy this file to gex/.env and fill in your values.
# gex/.env is gitignored — your token stays local.

# Tradier API token (Settings -> API Access on tradier.com).
# Leave unset to use CBOE's free delayed data instead.
TRADIER_TOKEN=

# Uncomment if your token is a free developer-sandbox token:
# TRADIER_SANDBOX=1

# How many expirations to pull from Tradier (default 20, front + horizon spread):
# TRADIER_MAX_EXPIRIES=30

# Anthropic API key for the "AI read" card (platform.claude.com -> API keys).
# Leave unset to run the dashboard without AI reads.
ANTHROPIC_API_KEY=

# Model and effort for AI reads (defaults shown; effort: low | medium | high):
# ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_EFFORT=medium

# Account buying power in dollars — AI-read trade structures must fit inside
# this with defined risk (default 2500):
# GEX_ACCOUNT_SIZE=2500

# Server port (default 8787):
# PORT=8787

# The server binds 127.0.0.1 only (the AI endpoint spends API credits).
# Uncomment to expose it on your LAN — only on a network you trust:
# GEX_HOST=0.0.0.0
